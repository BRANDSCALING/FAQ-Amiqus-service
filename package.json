{
  "name": "faq-amiqus-service",
  "version": "1.0.0",
  "description": "UCWS FAQ chatbot + Amiqus / DocuSeal compliance (split from DI agent)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build && node scripts/post-build.js",
    "format": "prettier --write \"src/**/*.ts\" \"faq-chatbot-knowledge/module/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,faq-chatbot-knowledge/module}/**/*.ts\" --fix",
    "test": "jest",
    "eval:faq": "node faq-chatbot-knowledge/scripts/eval-faq-chat.js",
    "test:faq-matrix": "node faq-chatbot-knowledge/scripts/faq-full-matrix.js",
    "test:faq-smoke": "node scripts/test-faq-chat.js",
    "faq:qa-batch": "node scripts/faq-qa-batch.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.113.0",
    "@llamaindex/openai": "^0.4.22",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.1.17",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.2.3",
    "llamaindex": "^0.12.1",
    "openai": "^4.20.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/faq-chatbot-knowledge/module/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "faq-chatbot-knowledge/module/**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  }
}
