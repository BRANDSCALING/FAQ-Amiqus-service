FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/faq-chatbot-knowledge ./faq-chatbot-knowledge
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
