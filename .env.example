# FAQ + Amiqus / DocuSeal service — copy to `.env` in this folder.

PORT=3000
NODE_ENV=development

OPENAI_API_KEY=

# FAQ (see faq-chatbot-knowledge/README.md)
# FAQ_KNOWLEDGE_PATH=
# FAQ_QUESTIONS_PATH=
# FAQ_EMBEDDING_MODEL=text-embedding-3-small
# FAQ_CHAT_MODEL=gpt-4o-mini

AMIQUS_API_KEY=
AMIQUS_WEBHOOK_SECRET=
# AMIQUS_ENABLE_CRIMINAL_RECORD_STEP=auto
# AMIQUS_DBS_STEP_TYPE=check.criminal_record
# AMIQUS_CRIMINAL_RECORD_REGION=england
# AMIQUS_CRIMINAL_RECORD_TYPE=standard
# Whether the end user pays for the DBS check via Amiqus's built-in card
# flow (true) or the cost is billed to the Brandscaling workspace (false).
# Default: true. Photo ID (£1) is always Brandscaling's cost; only DBS
# (£18) is affected by this flag.
# AMIQUS_CRIMINAL_RECORD_ENABLE_PAYMENT=true

DOCUSEAL_API_KEY=
DOCUSEAL_URL=https://api.docuseal.com
# Live combined HSP + Tenant SLA (Allianz_Housing_Complete_Contracts_1).
# This is what the Compliance tab uses; HSPSLA / TENANTS are legacy
# standalones kept for backwards-compat.
SLA_TEMPLATE_ID=4
HSPSLA_TEMPLATE_ID=
TENANTS_TEMPLATE_ID=

# Partner (Munawar) HTTP sync after webhooks
PARTNER_BACKEND_URL=

FRONTEND_URL=
